def main():
    """Main entry point for orchestrator."""
    import argparse
    import sys
    
    parser = argparse.ArgumentParser(description="{{ flow.description }}")
    parser.add_argument('--verbose', action='store_true', help='Enable verbose logging')
    parser.add_argument('--dynamic', action='store_true', help='Use YAML-driven execution mode')
    parser.add_argument('--flow', default='{{ flow.flow_id }}', help='Flow ID to execute')
    parser.add_argument('--spec', type=Path, help='Path to control_flows.yml')
    
    args = parser.parse_args()
    
    # Setup logging
    logging.basicConfig(
        level=logging.DEBUG if args.verbose else logging.INFO,
        format='%(asctime)s - %(name)s - %(levelname)s - %(message)s'
    )
    
    # Setup paths
    project_root = Path(__file__).parent.parent
    
    # Create orchestrator
    mode = 'dynamic' if args.dynamic else 'hardcoded'
    orchestrator = PhasesOrchestrator(
        project_root=project_root,
        mode=mode,
        spec_file=args.spec
    )
    
    try:
        # Execute all phases
        results = orchestrator.execute_all_phases(flow_id=args.flow)
        
        print("\n" + "=" * 70)
        print("✅ ALL PHASES COMPLETE")
        print("=" * 70)
        print(f"\nMode: {mode}")
        print(f"\nPhases executed:")
        for phase_id, phase_result in results.get('phases', {}).items():
            status = phase_result.get('status', 'unknown')
            emoji = '✅' if status == 'completed' else '⏭️' if status == 'skipped' else '❌'
            print(f"  {emoji} {phase_id}: {status}")
        
        return 0
        
    except Exception as e:
        print(f"\n❌ Orchestration failed: {e}")
        import traceback
        traceback.print_exc()
        return 1


if __name__ == '__main__':
    exit(main())
