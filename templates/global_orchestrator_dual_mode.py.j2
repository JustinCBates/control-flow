    def __init__(
        self,
        project_root: Path,
        ui=None,
        mode: str = 'hardcoded',
        spec_file: Optional[Path] = None
    ):
        """
        Initialize global phases orchestrator.
        
        Args:
            project_root: Root directory of the project
            ui: Optional UI handler
            mode: Execution mode - 'hardcoded' (default) or 'dynamic' (YAML-driven)
            spec_file: Path to control_flows.yml (used in dynamic mode)
        """
        self.project_root = project_root
        self.ui = ui
        self.mode = mode
        self.spec_file = spec_file or project_root / "design_specs/control_flows.yml"
        self.spec = None
        
        if self.mode == 'dynamic':
            self.spec = self._load_spec()
        
    def _load_spec(self) -> Optional[Dict[str, Any]]:
        """Load control flow specification from YAML."""
        if not self.spec_file.exists():
            logger.warning(f"Spec file not found: {self.spec_file}")
            return None
        
        try:
            with open(self.spec_file) as f:
                return yaml.safe_load(f)
        except Exception as e:
            logger.error(f"Failed to load spec: {e}")
            return None
    
    def execute_all_phases(self, flow_id: str = '{{ flow.flow_id }}') -> Dict[str, Any]:
        """
        Execute all phases in the flow.
        
        Args:
            flow_id: ID of the flow to execute
            
        Returns:
            Dict with aggregated results from all phases
        """
        logger.info(f"Executing all phases (mode: {self.mode})")
        
        if self.mode == 'dynamic':
            return self._execute_dynamic(flow_id)
        else:
            return self._execute_hardcoded()
    
    def _execute_dynamic(self, flow_id: str) -> Dict[str, Any]:
        """
        Execute phases using YAML specification (dynamic mode).
        
        Reads phase order and configuration from control_flows.yml.
        
        Args:
            flow_id: ID of the flow to execute
            
        Returns:
            Dict with aggregated results
        """
        if not self.spec:
            logger.warning("No spec available, falling back to hardcoded mode")
            return self._execute_hardcoded()
        
        flow = self.spec.get('flows', {}).get(flow_id)
        if not flow:
            logger.error(f"Flow '{flow_id}' not found in spec")
            return {'error': f"Flow '{flow_id}' not found"}
        
        logger.info(f"Executing flow: {flow.get('description', flow_id)}")
        
        context = {}
        results = {'phases': {}}
        
        # Execute phases from YAML
        for phase_spec in flow.get('phases', []):
            phase_id = phase_spec.get('phase_id')
            phase_status = phase_spec.get('status', 'PLANNED')
            
            # Skip planned/skipped phases
            if phase_status in ['PLANNED', 'SKIPPED']:
                logger.info(f"Skipping phase {phase_id} (status: {phase_status})")
                results['phases'][phase_id] = {'status': 'skipped'}
                continue
            
            logger.info(f"Executing phase: {phase_id}")
            
            # Get phase instance
            phase_instance = self._get_phase_instance(phase_spec)
            
            if not phase_instance:
                logger.error(f"Could not instantiate phase: {phase_id}")
                results['phases'][phase_id] = {'status': 'failed', 'error': 'Could not instantiate'}
                continue
            
            try:
                # Execute phase
                phase_result = phase_instance.execute(context)
                
                # Update context with phase results
                context.update(phase_result)
                results['phases'][phase_id] = {
                    'status': 'completed',
                    'artifacts': phase_result.get('artifacts', {})
                }
                
                logger.info(f"Phase {phase_id} completed successfully")
                
            except Exception as e:
                logger.error(f"Phase {phase_id} failed: {e}")
                results['phases'][phase_id] = {'status': 'failed', 'error': str(e)}
                # Optionally continue or break based on error handling policy
                break
        
        results['context'] = context
        return results
    
    def _get_phase_instance(self, phase_spec: Dict[str, Any]):
        """
        Get phase instance from specification.
        
        Dynamically loads the phase class and instantiates it.
        
        Args:
            phase_spec: Phase specification from YAML
            
        Returns:
            Phase instance or None if failed
        """
        phase_id = phase_spec.get('phase_id')
        
        # Try to get from registry
        phase_class = self.PHASE_CLASSES.get(phase_id)
        
        if not phase_class:
            # Try dynamic import from implementation section
            impl = phase_spec.get('implementation', {})
            module_path = impl.get('module')
            class_name = impl.get('class')
            
            if module_path and class_name:
                try:
                    import importlib
                    module = importlib.import_module(module_path)
                    phase_class = getattr(module, class_name)
                except (ImportError, AttributeError) as e:
                    logger.error(f"Could not import {module_path}.{class_name}: {e}")
                    return None
            else:
                logger.error(f"Phase class not found for: {phase_id}")
                return None
        
        # Instantiate phase with dynamic mode
        return phase_class(
            project_root=self.project_root,
            ui=self.ui,
            mode=self.mode,  # Pass mode down to phase
            spec_file=self.spec_file,
            phase_spec=phase_spec
        )
    
